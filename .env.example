# ============================================================
# Nootbook — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` or real secrets. `.env` is git-ignored.
# ============================================================

# ---- Database (Supabase PostgreSQL) -------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" (port 5432). Two things matter:
#  - Append ?sslmode=no-verify (the pooler requires TLS and its certificate is
#    not in every machine's default trust store).
#  - Encode any "@" in the password as %40.
# The <REGION> is in the pooler host, e.g. aws-0-ap-northeast-2.pooler.supabase.com.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# ---- App -----------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Supabase Auth (used from Step 2 onward) -----------------
# Supabase dashboard -> Project Settings -> API.
# These two are safe to expose to the browser (NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# SERVER ONLY — never expose this key to the browser or client bundle:
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
